  function setHeroReady() {

    if (heroClip.ready) return;

    heroClip.ready = true;

    if (heroVideo && heroVideo.duration && !isNaN(heroVideo.duration) && heroVideo.duration > 1) {

      heroClip.duration = heroVideo.duration;

