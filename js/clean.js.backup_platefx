  // ==========================================================================
  // Section 3: Authentic Ring-Bound 3D Menu Book Engine (#sweets)
  // - 10 Physical 3D Sheets, each hinged on left edge next to rings
  // - Forward: rotateY(0deg -> -180deg) over 1050ms with corner curl & shadows
  // - Backward: rotateY(-180deg -> 0deg)
  // - Multi-flip cascade: clicking far number flips pages quickly (~220ms each)
  // - Video management: Only active page video plays; hidden videos paused
  // - Keyboard (left/right) & touch swipe
  // - UI update: PAGE 01 / 10, sweet name, price, active pill
  // ==========================================================================
  function initSweetsBook() {
    var secEl = document.getElementById('sweets');
    if (!secEl) return;

    var sheetsStack = document.getElementById('book-sheets-stack');
    if (!sheetsStack) return;

    var sheets = Array.from(sheetsStack.querySelectorAll('.book-sheet'));
    var flexLayers = sheets.map(function (s) { return s.querySelector('.sheet-curl-flex'); });
    var underShadow = document.getElementById('book-under-shadow');

    var pageNumEl = document.getElementById('book-page-num');
    var titleEl = document.getElementById('book-sweet-title');
    var priceEl = document.getElementById('book-sweet-price');

    var prevBtn = document.getElementById('book-prev-btn');
    var nextBtn = document.getElementById('book-next-btn');
    var tabsNav = document.getElementById('book-tabs-nav');
    var tabPills = tabsNav ? Array.from(tabsNav.querySelectorAll('.strip-tab-pill')) : [];

    var currentPage = 0; // 0 to 9
    var totalPages = sheets.length;
    var isTurning = false;
    var autoTurnTimer = null;
    var autoTurnDelay = 10000; // 10s auto turn
    var userPauseTimer = null;

    // Helper: get video on a sheet
    function getVideo(pageIdx) {
      if (pageIdx < 0 || pageIdx >= totalPages) return null;
      return sheets[pageIdx].querySelector('video');
    }

    // Play active video safely
    function playPageVideo(pageIdx) {
      var v = getVideo(pageIdx);
      if (v) {
        v.currentTime = 0;
        var p = v.play();
        if (p !== undefined) p.catch(function () {});
      }
    }

    // Pause video safely
    function pausePageVideo(pageIdx) {
      var v = getVideo(pageIdx);
      if (v) {
        try { v.pause(); } catch (_) {}
      }
    }

    // Update bottom UI controls
    function updateUI(pageIdx) {
      var data = SWEETS_BOOK_DATA[pageIdx];
      if (!data) return;

      if (pageNumEl) pageNumEl.textContent = 'PAGE ' + String(pageIdx + 1).padStart(2, '0') + ' / ' + String(totalPages).padStart(2, '0');
      if (titleEl) titleEl.textContent = data.name;
      if (priceEl) priceEl.textContent = data.price;

      tabPills.forEach(function (pill, i) {
        var active = (i === pageIdx);
        pill.classList.toggle('is-active', active);
        pill.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      sheets.forEach(function (s, i) {
        s.classList.toggle('is-active', i === pageIdx);
      });
    }

    // Single Page Turn Forward (Page N -> N + 1)
    function turnForwardSingle(fromIdx, duration, callback) {
      var sheet = sheets[fromIdx];
      var flex = flexLayers[fromIdx];
      var dur = duration || 1050;
      var ease = 'cubic-bezier(0.28, 0.84, 0.42, 1)';

      sheet.style.transition = 'transform ' + dur + 'ms ' + ease;
      flex.style.transition = 'transform ' + dur + 'ms ' + ease;
      if (underShadow) {
        underShadow.style.transition = 'transform ' + dur + 'ms ' + ease + ', opacity ' + dur + 'ms ease';
        underShadow.style.transform = 'scaleX(0.8)';
        underShadow.style.opacity = '0.7';
      }

      // Animate 3D rotation & corner curl
      sheet.style.transform = 'rotateY(-180deg)';
      flex.style.transform = 'rotate3d(1, -0.4, 0.1, 16deg) skew(-2deg, -1deg)';

      // Mid-turn: update z-index for left stack & start next video
      setTimeout(function () {
        sheet.style.zIndex = fromIdx + 1;
        playPageVideo(fromIdx + 1);
        if (underShadow) {
          underShadow.style.transform = 'scaleX(0.1)';
          underShadow.style.opacity = '0';
        }
      }, Math.round(dur * 0.48));

      // End of turn: flatten curl, pause previous video
      setTimeout(function () {
        flex.style.transition = 'none';
        flex.style.transform = 'none';
        pausePageVideo(fromIdx);
        if (callback) callback();
      }, dur + 20);
    }

    // Single Page Turn Backward (Page N -> N - 1)
    function turnBackwardSingle(fromIdx, duration, callback) {
      var targetIdx = fromIdx - 1;
      var sheet = sheets[targetIdx];
      var flex = flexLayers[targetIdx];
      var dur = duration || 1050;
      var ease = 'cubic-bezier(0.28, 0.84, 0.42, 1)';

      // Bring sheet to top of turn stack
      sheet.style.zIndex = totalPages + 2;

      sheet.style.transition = 'transform ' + dur + 'ms ' + ease;
      flex.style.transition = 'transform ' + dur + 'ms ' + ease;
      if (underShadow) {
        underShadow.style.transition = 'transform ' + dur + 'ms ' + ease + ', opacity ' + dur + 'ms ease';
        underShadow.style.transform = 'scaleX(0.8)';
        underShadow.style.opacity = '0.7';
      }

      // Animate 3D rotation back to 0deg
      sheet.style.transform = 'rotateY(0deg)';
      flex.style.transform = 'rotate3d(1, 0.4, -0.1, 16deg) skew(2deg, 1deg)';

      // Mid-turn: start incoming video
      setTimeout(function () {
        playPageVideo(targetIdx);
        if (underShadow) {
          underShadow.style.transform = 'scaleX(0.1)';
          underShadow.style.opacity = '0';
        }
      }, Math.round(dur * 0.48));

      // End of turn: reset z-index and flatten
      setTimeout(function () {
        flex.style.transition = 'none';
        flex.style.transform = 'none';
        sheet.style.zIndex = totalPages - targetIdx;
        pausePageVideo(fromIdx);
        if (callback) callback();
      }, dur + 20);
    }

    // Master turnToPage: handles single flips and rapid cascade flips
    function turnToPage(targetPage) {
      if (isTurning || targetPage === currentPage) return;
      if (targetPage < 0 || targetPage >= totalPages) return;

      isTurning = true;
      var delta = targetPage - currentPage;

      if (delta === 1) {
        // Normal single forward turn (1050ms)
        turnForwardSingle(currentPage, 1050, function () {
          currentPage = targetPage;
          updateUI(currentPage);
          isTurning = false;
        });
      } else if (delta === -1) {
        // Normal single backward turn (1050ms)
        turnBackwardSingle(currentPage, 1050, function () {
          currentPage = targetPage;
          updateUI(currentPage);
          isTurning = false;
        });
      } else if (delta > 1) {
        // Rapid cascade forward (220ms per sheet)
        var step = currentPage;
        function cascadeForward() {
          if (step < targetPage) {
            var curStep = step;
            step++;
            var isLast = (step === targetPage);
            turnForwardSingle(curStep, 220, function () {
              if (isLast) {
                currentPage = targetPage;
                updateUI(currentPage);
                isTurning = false;
              } else {
                cascadeForward();
              }
            });
          }
        }
        cascadeForward();
      } else if (delta < -1) {
        // Rapid cascade backward (220ms per sheet)
        var stepB = currentPage;
        function cascadeBackward() {
          if (stepB > targetPage) {
            var curStepB = stepB;
            stepB--;
            var isLastB = (stepB === targetPage);
            turnBackwardSingle(curStepB, 220, function () {
              if (isLastB) {
                currentPage = targetPage;
                updateUI(currentPage);
                isTurning = false;
              } else {
                cascadeBackward();
              }
            });
          }
        }
        cascadeBackward();
      }
    }

    // Next button
    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        turnToPage((currentPage + 1) % totalPages);
        pauseAutoTurnForUser();
      });
    }

    // Prev button
    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        turnToPage((currentPage - 1 + totalPages) % totalPages);
        pauseAutoTurnForUser();
      });
    }

    // Number pills click
    tabPills.forEach(function (pill, i) {
      pill.addEventListener('click', function () {
        turnToPage(i);
        pauseAutoTurnForUser();
      });
    });

    // Keyboard navigation (Left / Right)
    window.addEventListener('keydown', function (e) {
      if (document.activeElement && (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'TEXTAREA')) return;
      if (e.key === 'ArrowRight') {
        turnToPage((currentPage + 1) % totalPages);
        pauseAutoTurnForUser();
      } else if (e.key === 'ArrowLeft') {
        turnToPage((currentPage - 1 + totalPages) % totalPages);
        pauseAutoTurnForUser();
      }
    });

    // Touch swipe support on mobile
    var touchStartX = 0;
    secEl.addEventListener('touchstart', function (e) {
      if (e.changedTouches && e.changedTouches[0]) touchStartX = e.changedTouches[0].clientX;
    }, { passive: true });

    secEl.addEventListener('touchend', function (e) {
      if (e.changedTouches && e.changedTouches[0]) {
        var diffX = e.changedTouches[0].clientX - touchStartX;
        if (Math.abs(diffX) > 40) {
          if (diffX < 0) {
            turnToPage((currentPage + 1) % totalPages);
          } else {
            turnToPage((currentPage - 1 + totalPages) % totalPages);
          }
          pauseAutoTurnForUser();
        }
      }
    }, { passive: true });

    // Auto turn timer
    function startAutoTurn() {
      stopAutoTurn();
      if (prefersReducedMotion) return;
      autoTurnTimer = setInterval(function () {
        if (!isTurning) {
          turnToPage((currentPage + 1) % totalPages);
        }
      }, autoTurnDelay);
    }

    function stopAutoTurn() {
      if (autoTurnTimer) {
        clearInterval(autoTurnTimer);
        autoTurnTimer = null;
      }
    }

    function pauseAutoTurnForUser() {
      stopAutoTurn();
      if (userPauseTimer) clearTimeout(userPauseTimer);
      userPauseTimer = setTimeout(function () {
        if (isBookInView) startAutoTurn();
      }, 16000);
    }

    // Observer: only auto turn when in view
    var isBookInView = false;
    var bookObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        isBookInView = entry.isIntersecting;
        if (isBookInView) {
          playPageVideo(currentPage);
          startAutoTurn();
        } else {
          pausePageVideo(currentPage);
          stopAutoTurn();
        }
      });
    }, { threshold: 0.25 });
    bookObserver.observe(secEl);

    // Initial setup
    updateUI(0);
    playPageVideo(0);
  }



