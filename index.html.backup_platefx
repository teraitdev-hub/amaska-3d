  align-items: center;
  justify-content: center;
  padding: clamp(16px, 3.5vw, 40px);
  opacity: 0;
  pointer-events: none;
  visibility: hidden;
  transition: opacity .4s var(--ease), visibility .4s;
}
.box-modal.open {
  opacity: 1;
  pointer-events: auto;
  visibility: visible;
}
.box-modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(62, 0, 32, 0.48);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  transition: opacity .4s var(--ease);
}
.box-modal-dialog {
