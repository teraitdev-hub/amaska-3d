}
.box-modal-nav {
  position: absolute;
  top: 50%;
  translate: 0 -50%;
  z-index: 10;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: #fff;
  border: 1px solid var(--line);
  color: var(--berry);
  display: grid;
  place-items: center;
