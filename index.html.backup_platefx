<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Amaskā · Artisanal Sweets &amp; Savouries · Sarjapur Road, Bengaluru</title>
<meta name="description" content="Handcrafted sweets, pure ghee delicacies, namkeen, and dining on Sarjapur Road, Bengaluru. Each sweet and savoury is a memory made tangible.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600&family=Montserrat:wght@500;600;700&display=swap" rel="stylesheet">

<style>
:root {
  --berry: #7B003C;
  --berry-deep: #4E0026;
  --berry-dark: #22020e;
  --gold: #C9A54A;
  --gold-light: #F4DF9B;
  --paper: #FBF7F2;
  --blush: #F6E9EB;
  --ink: #3E0020;
  --soft: #6E535E;
  --line: rgba(123, 0, 60, 0.14);
  --display: 'Fraunces', Georgia, serif;
  --body: 'Inter', system-ui, -apple-system, sans-serif;
  --label: 'Montserrat', system-ui, sans-serif;
  --ease: cubic-bezier(0.2, 0.8, 0.2, 1);
  --vh: 100vh;
}

*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-tap-highlight-color: transparent; }
body {
  margin: 0;
  font-family: var(--body);
  background: var(--paper);
  color: var(--ink);
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

img, video { max-width: 100%; height: auto; display: block; }
a { color: inherit; }
button { font-family: inherit; }

.wrap { max-width: 1220px; margin: 0 auto; padding-inline: max(24px, env(safe-area-inset-left, 0px)) max(24px, env(safe-area-inset-right, 0px)); }

/* Typography */
h1, h2, h3, h4 { font-family: var(--display); font-weight: 500; line-height: 1.15; margin: 0; }
em { font-style: italic; font-weight: 400; color: var(--berry); }
.label {
  display: block;
  font: 700 .72rem var(--label);
  letter-spacing: .24em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 8px;
}
.lede { font-size: clamp(1.05rem, 1.8vw, 1.25rem); color: var(--soft); line-height: 1.6; }

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font: 600 .78rem var(--label);
  letter-spacing: .16em;
  text-transform: uppercase;
  padding: 13px 26px;
  border-radius: 999px;
  text-decoration: none;
  cursor: pointer;
  transition: all .3s var(--ease);
  border: 1px solid transparent;
}
.btn-berry { background: var(--berry); color: #fff; }
.btn-berry:hover { background: var(--berry-deep); transform: translateY(-2px); box-shadow: 0 10px 24px -8px rgba(123,0,60,0.5); }
.btn-light { background: #fff; color: var(--berry); border-color: rgba(255,255,255,0.4); }
.btn-light:hover { background: #FAF5EF; transform: translateY(-2px); box-shadow: 0 10px 24px -8px rgba(0,0,0,0.3); }
.btn-ghost { background: transparent; color: #fff; border-color: rgba(255,255,255,0.5); }
.btn-ghost:hover { background: rgba(255,255,255,0.15); border-color: #fff; }
.btn-gold { background: var(--gold); color: #fff; }
.btn-gold:hover { background: #b8913b; }
.btn-sm { padding: 9px 18px; font-size: .72rem; }

/* Top Progress Bar */
.progress { position: fixed; top: 0; left: 0; right: 0; height: 3px; background: var(--gold); z-index: 100; transform-origin: 0 50%; transform: scaleX(0); will-change: transform; }

/* Header */
.top {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 60;
  padding-block: 18px;
  transition: background .35s var(--ease), padding .35s var(--ease), box-shadow .35s var(--ease);
}
.top .wrap { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
.top .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }
.top .brand img.on-dark, .top .brand img.on-light { height: 34px; width: auto; transition: opacity .3s; }
.top .brand .on-light { display: none; }
.brand-symbol {
  width: 34px;
  height: 34px;
  object-fit: contain;
  flex-shrink: 0;
  filter: drop-shadow(0 2px 8px rgba(0,0,0,0.3));
}
.rotating-symbol {
  animation: amaskaRotate 22s linear infinite;
  transform-origin: 50% 50%;
  will-change: transform;
}
@keyframes amaskaRotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.top .nav { list-style: none; margin: 0; padding: 0; display: flex; gap: clamp(16px, 2.5vw, 32px); color: #fff; }
.top .nav a { text-decoration: none; font-size: .95rem; font-weight: 500; opacity: .9; position: relative; padding-block: 4px; }
.top .nav a::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 1.5px; background: currentColor; transform: scaleX(0); transition: transform .25s var(--ease); }
.top .nav a:hover::after { transform: scaleX(1); }
.top .call { padding: 10px 20px; background: #fff; color: var(--berry); font-size: .74rem; }
.menu-toggle { display: none; background: transparent; border: 1px solid rgba(255,255,255,0.4); color: #fff; border-radius: 999px; padding: 8px 16px; font: 600 .75rem var(--label); letter-spacing: .12em; text-transform: uppercase; cursor: pointer; }

/* Header Solid State */
.top.solid {
  background: rgba(250, 245, 239, 0.94);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  padding-block: 12px;
  box-shadow: 0 10px 30px -15px rgba(62,0,32,0.15);
}
.top.solid .brand .on-dark { display: none; }
.top.solid .brand .on-light { display: block; }
.top.solid .nav { color: var(--ink); }
.top.solid .call { background: var(--berry); color: #fff; }
.top.solid .menu-toggle { color: var(--ink); border-color: var(--line); }

@media (max-width: 960px) {
  .top .call { display: none; }
  .menu-toggle { display: block; }
  .top .nav {
    position: fixed;
    inset: 0;
    top: 70px;
    height: calc(100vh - 70px);
    background: var(--paper);
    color: var(--ink);
    flex-direction: column;
    padding: 30px 24px;
    gap: 16px;
    transform: translateY(-120%);
    transition: transform .35s var(--ease);
    box-shadow: 0 30px 40px rgba(62,0,32,0.2);
  }
  .top .nav.open { transform: none; }
  .top .nav a { font-size: 1.25rem; font-family: var(--display); padding: 8px 0; border-bottom: 1px solid var(--line); }
}

/* ==========================================================================
   HERO: Exact Scroll-Scrubbed Box Opening (Google Flow video/hero-16x9.mp4)
   ========================================================================== */
.cine.hero {
  position: relative;
  height: calc(var(--len, 3.2) * var(--vh));
  background: var(--paper);
}
.cine.hero .stage {
  position: sticky;
  top: 0;
  height: var(--vh);
  overflow: hidden;
}
.hero .frame {
  position: absolute;
  inset: 0;
  overflow: hidden;
  background: #3a0a1c;
  will-change: clip-path;
}
.hero .frame video, .hero .frame .still {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
.hero .frame .still { transform: scale(1.04); }
.hero .frame video { opacity: 0; transition: opacity .6s; z-index: 1; }
.hero.has-clip .frame video, .hero .frame.has-clip video { opacity: 1; }
.hero.has-clip .frame .still, .hero .frame.has-clip .still { opacity: 0; pointer-events: none; }

/* Subtle dark gradient overlay so text is crisp on any frame */
.hero .frame::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(30,2,14,0.76) 0%, rgba(30,2,14,0.3) 50%, rgba(30,2,14,0.65) 100%);
  pointer-events: none;
}
.hero .copy {
  position: absolute;
  z-index: 3;
  left: max(6vw, 24px);
  top: 50%;
  translate: 0 -48%;
  width: min(44vw, 620px);
  color: #fff;
}
.hero .line { display: grid; gap: 20px; }
.hero .line + .line {
  position: absolute;
  left: 0;
  top: 50%;
  translate: 0 -50%;
  opacity: 0;
  visibility: hidden;
}
.hero h1, .hero h2 { font-size: clamp(2.3rem, 5.2vw, 4.6rem); color: #fff; }
.hero em { color: var(--gold-light); font-weight: 400; }
.hero .label { color: var(--gold-light); }
.hero .lede { color: rgba(255,255,255,0.9); }
.hero .acts { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 6px; }

.cue {
  position: absolute;
  left: 50%;
  bottom: calc(24px + env(safe-area-inset-bottom, 0px));
  translate: -50% 0;
  z-index: 3;
  display: grid;
  justify-items: center;
  gap: 8px;
  font: 600 .68rem var(--label);
  letter-spacing: .24em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.85);
  pointer-events: none;
  transition: opacity .3s;
}
.cue i {
  width: 1.5px;
  height: 36px;
  background: rgba(255,255,255,0.8);
  transform-origin: 50% 0;
  animation: cueAnim 1.8s ease-in-out infinite;
}
@keyframes cueAnim { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }

@media (max-width: 860px) {
  .hero .frame::after {
    background: linear-gradient(180deg, rgba(30,2,14,0.85) 0%, rgba(30,2,14,0.35) 45%, rgba(30,2,14,0.75) 100%);
  }
  .hero .copy {
    left: 20px;
    right: 20px;
    width: auto;
    top: calc(84px + env(safe-area-inset-top, 0px));
    translate: none;
  }
  .hero .line + .line { top: 0; translate: none; }
  .hero h1, .hero h2 { font-size: clamp(1.9rem, 7.8vw, 2.7rem); }
  .hero .lede { font-size: .98rem; }
  .hero .frame video, .hero .frame .still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }
}

/* ==========================================================================
   OUR STORY: 3D Cashew Falling Canvas & Heritage Story (Frameless 3D)
   ========================================================================== */
.sec { padding-block: clamp(64px, 8vw, 110px); position: relative; }
.story {
  position: relative;
  background: #E8DDC4; /* Matches exact video background color */
  overflow: hidden;
  min-height: min(94vh, 900px);
  padding-block: clamp(80px, 9vw, 130px);
  display: flex;
  align-items: center;
  border-bottom: none;
}

/* Smooth blend from Hero paper to Cashew Canvas */
.story-top-blend {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 80px;
  background: linear-gradient(180deg, var(--paper) 0%, rgba(232, 221, 196, 0) 100%);
  pointer-events: none;
  z-index: 2;
}

/* Cashew Falling 3D Video Background - 100% Full Visibility */
.story-bg-video-wrap {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 1;
}
.story-bg-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 1 !important;
  filter: contrast(1.05) saturate(1.08);
  display: block;
  transform: scale(1.04);
  will-change: transform;
}

.story .wrap {
  position: relative;
  z-index: 3;
  width: 100%;
  max-width: 1160px;
}

/* Pure Frameless Text: Floating directly upon falling cashews */
.story-card {
  max-width: 820px;
  background: transparent !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  border: none !important;
  border-radius: 0 !important;
  padding: 0 !important;
  box-shadow: none !important;
  display: grid;
  gap: 22px;
}
.story-card h2 {
  font-size: clamp(2.5rem, 4.8vw, 4rem);
  color: var(--berry);
  line-height: 1.15;
  text-shadow: 0 2px 20px rgba(232, 221, 196, 0.95), 0 0 5px rgba(255, 255, 255, 0.85);
}
.story-card .lede {
  font-size: clamp(1.12rem, 1.9vw, 1.32rem);
  color: #2c0717;
  line-height: 1.68;
  font-weight: 500;
  text-shadow: 0 1px 16px rgba(232, 221, 196, 0.95), 0 0 4px rgba(255, 255, 255, 0.75);
  max-width: 740px;
}

/* Frameless Pillars with luxury gold top rule */
.story-pillars {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  gap: 24px;
  margin-top: 14px;
}
.pillar {
  background: transparent !important;
  border: none !important;
  border-top: 2px solid rgba(123, 0, 60, 0.28) !important;
  border-radius: 0 !important;
  padding: 16px 0 0 !important;
  display: grid;
  gap: 8px;
  box-shadow: none !important;
  transition: border-color .3s;
}
.pillar:hover {
  border-top-color: var(--berry) !important;
}
.pillar b {
  font: 700 .86rem var(--label);
  letter-spacing: .2em;
  color: var(--gold);
}
.pillar span {
  font-weight: 600;
  font-size: 1.05rem;
  color: #35081b;
  line-height: 1.45;
  text-shadow: 0 1px 12px rgba(232, 221, 196, 0.95), 0 0 3px rgba(255, 255, 255, 0.7);
}
  border-bottom: 2px solid rgba(123, 0, 60, 0.15);
  pointer-events: none;
  z-index: 4;
}

/* ==========================================================================
   3D FRAMELESS SWEETS SHOWCASE (Pure 3D Floating Sweets - NO BOX FRAMES!)
   ========================================================================== */
.sweets-3d-sec {
  background: #FDF9F5;
  position: relative;
  overflow: hidden;
  border-bottom: 1px solid var(--line);
}

/* ==========================================================================
   OUR SWEETS: Full-Flush Living 3D Menu Book (#sweets)
   Fits 100% in ONE screen (calc(100vh - 74px)).
   Full display screen, edge-to-edge flush, no borders, no redundant text.
   Realistic, tactile, heavy cotton paper 3D page curl (1.4s natural curve).
   Transparent bottom navigation (no white background, no duplicate buttons).
   ========================================================================== */
/* ==========================================================================
   OUR SWEETS: Authentic Ring-Bound 3D Menu Book Engine (#sweets)
   - Stationary book frame (dark oak table, brass rings, leather strap)
   - 10 real 3D physical sheets that hinge on the left edge next to rings
   - Organic paper curl, moving specular highlights & under-shadow
   - Completely visible bottom pills (never clipped on desktop or mobile)
   ========================================================================== */
.sweets-book-sec {
  position: relative;
  width: 100%;
  min-height: calc(100vh - 74px);
  height: auto;
  background: #140905;
  scroll-margin-top: 74px;
  padding: 24px 24px calc(36px + env(safe-area-inset-bottom, 0px)) 24px;
  margin: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: visible; /* Never cut off bottom buttons */
  box-sizing: border-box;
}

/* 3D Book Stage Container */
.book-stage {
  position: relative;
  width: min(100%, 1240px);
  aspect-ratio: 16 / 9;
  max-height: calc(100vh - 180px);
  perspective: 2500px;
  perspective-origin: 25% 50%;
  transform-style: preserve-3d;
  background: #180C07;
  border-radius: 8px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8), 0 6px 20px rgba(0, 0, 0, 0.6);
  overflow: visible;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Stationary Book Bed */
.book-stationary-bed {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  background: #140905 url('assets/poster-01-gulab-jamun.webp') center center / cover no-repeat;
  filter: brightness(0.7) blur(2px);
  z-index: 1;
  pointer-events: none;
  border-radius: 6px;
}

/* 3D Sheets Stack (Sits over the right page of the open book) */
.book-sheets-stack {
  position: absolute;
  left: 17%;
  top: 2%;
  width: 71%;
  height: 96%;
  z-index: 5;
  perspective: 2600px;
  perspective-origin: 0% 50%;
  transform-style: preserve-3d;
  overflow: visible;
}

/* Individual Physical Sheet */
.book-sheet {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  transform-origin: 0% 50%; /* Hinges on the left spine next to rings */
  transform-style: preserve-3d;
  will-change: transform;
  pointer-events: none;
}

.book-sheet.is-active {
  pointer-events: auto;
}

/* Inner flex layer for organic corner paper curl */
.sheet-curl-flex {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  transform-origin: 100% 100%; /* Bottom-right corner lifts & bends */
  transform-style: preserve-3d;
  will-change: transform;
}

/* Sheet Faces: Front and Back */
.sheet-face {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  border-radius: 2px 6px 6px 2px;
  overflow: hidden;
}

/* Front Face: Sweet with active video */
.sheet-front {
  z-index: 2;
  background: #F9F4EB;
  box-shadow: -4px 0 20px rgba(0, 0, 0, 0.4), 0 8px 30px rgba(0, 0, 0, 0.5);
}

/* Top Ornamental Header */
.page-top-decor {
  position: absolute;
  top: 14px;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  pointer-events: none;
}

.page-vintage-title {
  font-family: var(--display, 'Cinzel', serif);
  font-size: clamp(0.95rem, 1.8vw, 1.45rem);
  font-weight: 600;
  color: #382414;
  letter-spacing: 0.08em;
  text-shadow: 0 1px 2px rgba(255, 255, 255, 0.8);
  margin: 0;
  padding: 0;
}

.decor-ornament {
  color: rgba(145, 105, 55, 0.65);
  font-size: 1.1rem;
}

/* Center Sweet Media: Video & Poster */
.page-sweet-media {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.page-sweet-media video,
.page-sweet-media img {
  position: absolute;
  /* Mathematically crop to align with stationary book frame */
  width: calc(100% / 0.71);
  height: calc(100% / 0.96);
  left: calc(-17% / 0.71);
  top: calc(-2% / 0.96);
  object-fit: cover;
  object-position: center center;
  display: block;
}

.page-sweet-media video {
  z-index: 2;
}

.page-sweet-media img {
  z-index: 1;
}

/* Bottom Page Marker */
.page-bottom-marker {
  position: absolute;
  bottom: 12px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  font-family: var(--display, 'Cinzel', serif);
  font-size: 0.85rem;
  font-weight: 500;
  color: rgba(60, 40, 25, 0.65);
  letter-spacing: 0.14em;
  pointer-events: none;
}

/* Specular Paper Highlight */
.sheet-specular-highlight {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(
    105deg,
    rgba(255, 255, 255, 0) 15%,
    rgba(255, 255, 255, 0.35) 42%,
    rgba(255, 255, 255, 0.75) 50%,
    rgba(0, 0, 0, 0.25) 58%,
    rgba(0, 0, 0, 0) 70%
  );
  opacity: 0;
  transform: translateX(-40%);
  will-change: transform, opacity;
}

.sheet-edge-shadow {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 45px;
  background: linear-gradient(to left, rgba(0, 0, 0, 0.3) 0%, transparent 100%);
  pointer-events: none;
}

/* Back Face: Plain Cream Cotton Paper */
.sheet-back {
  transform: rotateY(180deg);
  z-index: 1;
  background: #EFE7DB;
  border-radius: 6px 2px 2px 6px;
  box-shadow: inset 0 0 50px rgba(100, 70, 40, 0.25), inset 24px 0 40px rgba(45, 25, 10, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-back-texture {
  position: absolute;
  inset: 18px;
  border: 1px dashed rgba(160, 130, 90, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-back-inner {
  text-align: center;
  color: rgba(90, 60, 35, 0.35);
  font-family: var(--display, 'Cinzel', serif);
  letter-spacing: 0.18em;
  user-select: none;
}

.sheet-back-watermark {
  display: block;
  font-size: 2.2rem;
  font-weight: 700;
  margin-bottom: 6px;
  color: rgba(123, 0, 60, 0.32);
}

.sheet-back-inner small {
  font-size: 0.74rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
}

.sheet-back-shadow {
  position: absolute;
  inset: 0;
  background: linear-gradient(to right, rgba(0, 0, 0, 0.35) 0%, transparent 35%, rgba(0, 0, 0, 0.15) 100%);
  pointer-events: none;
}

/* Ambient Moving Under-Shadow */
.book-under-shadow {
  position: absolute;
  left: 17%;
  top: 2%;
  width: 71%;
  height: 96%;
  pointer-events: none;
  z-index: 4;
  background: linear-gradient(
    to right,
    rgba(14, 7, 3, 0.7) 0%,
    rgba(14, 7, 3, 0.4) 18%,
    rgba(14, 7, 3, 0.15) 40%,
    rgba(14, 7, 3, 0.03) 65%,
    transparent 100%
  );
  transform-origin: 0% 50%;
  transform: scaleX(0.1);
  opacity: 0;
  filter: blur(4px);
  will-change: transform, opacity;
}

/* Navigation Arrows on Book Left & Right */
.book-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 25;
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: rgba(22, 11, 7, 0.7);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1.5px solid rgba(244, 223, 155, 0.4);
